#!/bin/sh
# Snowline Rally — 提交前拦截「签名物料 / 本机绝对路径」。
#
# 启用方式（每个克隆只需一次）：
#     git config core.hooksPath .githooks
#
# 为什么需要它：DevEco 会把你的证书路径、keyAlias、keyPassword/storePassword
# 写进 app/build-profile.json5。该文件已在 .gitignore 中，但一旦有人复制成
# 别的文件名（build-profile.local.json5、备份、临时导出……）仍可能被提交。
# 这个钩子是最后一道闸门。
set -u

fail=0

# 1) 按扩展名拦截证书 / 私钥 / 安装包
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    *.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|*.cer|*.p7b|*.hap|*.app)
      echo "✗ 拒绝提交证书/私钥/安装包：$f" >&2
      fail=1
      ;;
  esac
done

# 2) 按内容拦截签名口令与本机路径（跳过文档与二进制，避免误伤）
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    *.png|*.jpg|*.jpeg|*.webp|*.ico|*.hap|*.app) continue ;;
    .github/*|.githooks/*) continue ;;
  esac
  if git show ":$f" 2>/dev/null | grep -qE '"(keyPassword|storePassword)"|/storage/Users/|/Users/[^/]+/\.ohos|com\.example\.snowlinerally|BEGIN [A-Z ]*PRIVATE KEY'; then
    echo "✗ $f 含敏感信息（口令 / 本机路径 / 旧包名），请先清理" >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "提交已被阻止。说明见 README 的「开源说明」一节。" >&2
fi

exit "$fail"
